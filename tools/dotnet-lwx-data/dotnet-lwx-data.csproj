<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-lwx-data</ToolCommandName>
    <PackageId>LwXLab.Data.Tool</PackageId>
    <Description>dotnet lwx-data: database doctor, connection inspection, schema, migration-history and manifest tooling.</Description>
    <PackageTags>dotnet-tool;database;doctor;efcore</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LwXLab.Data.Tooling/LwXLab.Data.Tooling.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.Diagnostics/LwXLab.Data.Diagnostics.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.PostgreSql/LwXLab.Data.PostgreSql.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.CockroachDb/LwXLab.Data.CockroachDb.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.SqlServer/LwXLab.Data.SqlServer.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.Sqlite/LwXLab.Data.Sqlite.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.MySql/LwXLab.Data.MySql.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.MariaDb/LwXLab.Data.MariaDb.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.Oracle/LwXLab.Data.Oracle.csproj" />
    <ProjectReference Include="../../src/LwXLab.Data.Supabase/LwXLab.Data.Supabase.csproj" />
  </ItemGroup>
</Project>
