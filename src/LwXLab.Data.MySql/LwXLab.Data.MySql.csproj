<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LwXLab.Data.MySql</PackageId>
    <Description>MySQL Connector/NET ADO.NET and Entity Framework Core helpers for LwXLab.Data.</Description>
    <PackageTags>mysql;efcore;database;ado.net;connector-net</PackageTags>
    <PackageReleaseNotes>Adds MySQL connection factory, TLS-safe normalization, and schema-free EF Core registration.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LwXLab.Data/LwXLab.Data.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="../LwXLab.Data.EntityFrameworkCore/LwXLab.Data.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="MySql.Data" Version="26.7.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="MySql.EntityFrameworkCore" Version="8.0.28" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="MySql.EntityFrameworkCore" Version="9.0.17" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
  </ItemGroup>
</Project>
