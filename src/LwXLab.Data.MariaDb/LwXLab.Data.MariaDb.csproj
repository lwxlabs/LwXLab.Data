<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LwXLab.Data.MariaDb</PackageId>
    <Description>MariaDB/MySqlConnector helpers for LwXLab.Data, with EF Core support where a stable Pomelo provider is available.</Description>
    <PackageTags>mariadb;mysqlconnector;pomelo;efcore;database;ado.net</PackageTags>
    <PackageReleaseNotes>Adds MariaDB ADO.NET support on all targets and EF Core registration on .NET 8/9.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LwXLab.Data/LwXLab.Data.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
    <ProjectReference Include="../LwXLab.Data.EntityFrameworkCore/LwXLab.Data.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>
</Project>
